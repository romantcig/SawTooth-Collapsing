# Sawtooth Proxy Configuration File
# All fields have built-in defaults; only override what you need to change.

server:
  # Listen port, default: 9099 (optional)
  port: 9099
  # Listen host, default: localhost (optional)
  host: localhost

proxy:
  # Anthropic API target URL, default: https://api.anthropic.com (optional)
  target: https://api.anthropic.com
  # Usage deflation coefficient (0.0-1.0), default: 1.0 = off (optional).
  # Both 0 and 1.0 mean disabled. Sawtooth collapsing already caps the forwarded
  # context, so Claude Code's auto-compact is structurally out of reach and there
  # is normally nothing to suppress. Lower it only if your model's context window
  # sits close to stubify.token_threshold.
  deflation: 1.0

transport:
  # TCP connection timeout only, default: 15s. Set to 0 to disable this protection.
  dial_timeout: 15s
  # TLS handshake timeout only, default: 15s. Set to 0 to disable this protection.
  tls_handshake_timeout: 15s
  # Time to wait for response headers after a stream request is fully written, default: 10m. Set to 0 to disable.
  stream_header_timeout: 10m
  # Time to wait for response headers after a non-stream request is fully written, default: 30m. Set to 0 to disable.
  non_stream_header_timeout: 30m
  # Maximum continuous interval without upstream response bytes, default: 10m. Each received byte resets it; set to 0 to disable.
  response_idle_timeout: 10m
  # Extreme absolute limit for the whole upstream request, default: 60m. Set to 0 to disable.
  # With hard_timeout=0, the Claude Code request context and the other phase protections control the lifecycle; the old 120s limit is not restored.
  hard_timeout: 60m

debug:
  # Whether to enable structured debug facts, default: false (optional)
  enabled: false
  # Whether to additionally save complete raw inbound, forwarded, and response bodies.
  # This may contain sensitive prompts and tool results; default: false (optional)
  full_body: false
  # Directory to save debug data, default: ./data/ (optional)
  data_dir: ./data/

stubify:
  # Total token threshold to trigger deflation, default: 100000 (optional)
  token_threshold: 200000
  # Number of recent messages to keep un-stubified at the tail, default: 8 (optional)
  keep_recent: 8
  # Whether to keep thinking blocks, default: false (optional)
  # The reasoning process in thinking blocks might be valuable for context continuity, but the goal of sawtooth collapsing is to extract results rather than the process itself.
  keep_thinking: false

collapse:
  # Whether to enable collapsing, default: true (optional)
  enabled: true
  # [DEPRECATED] No longer read in Phase F collapse-first architecture.
  # Collapse is directly determined by the token budget logic in CalcCollapseCutoff, threshold * multiplier is no longer used.
  # This key is kept to prevent errors with old config files, but does not affect behavior.
  threshold_multiplier: 1.5
  # Whether to merge consecutive Stage-3 stub messages into compacted summary blocks,
  # default: true (optional).
  # WARNING: do not set this to false. Decay blanks the body of every Stage-3 message
  # unconditionally, and compaction is what puts that content back as a summary block.
  # Turning compaction off blanks the messages anyway with nothing to cover them,
  # which is silent information loss rather than a smaller archive.
  compact_enabled: true

frozen:
  # Whether to enable frozen prefix, default: true (optional)
  enabled: true
  # Legacy compatibility value; effective Frozen TTL follows cache.cache_ttl
  ttl_minutes: 30

cache:
  # Whether to enable cache_control management, default: true (optional)
  enabled: true
  # Maximum cache_control breakpoints (Anthropic hard limit is 4)
  breakpoint_limit: 4
  # Cache TTL policy: "ephemeral" (default 5m) or "1h"
  # Affects Frozen TTL and the adaptive derivation of SawtoothTrigger pause thresholds
  cache_ttl: "ephemeral"
